%% สร้างจากโครงตารางจริงใน Supabase (public schema) 6 พ.ย. 2569
%% แสดงเฉพาะ PK, FK และคอลัมน์หลัก — คอลัมน์ทั้งหมดดูใน Data Dictionary · profiles ใช้ร่วมกับระบบยืม-คืน
%% สัญลักษณ์ Crow's Foot (IE): เส้นทึบ = identifying (PK ของลูกมี FK ของแม่) · เส้นประ = non-identifying · จำนวนฝั่งลูกตาม constraint จริง (ไม่มี unique = หลายแถว)
erDiagram
  profiles {
    uuid id PK
    text role
    text full_name
  }
  rooms {
    text id PK
    text building
    text floor
    boolean active
  }
  computer_stations {
    uuid id PK
    text room_id FK
    integer group_no
    text name
    text status
    boolean active
  }
  lan_ports {
    uuid id PK
    text room_id FK
    integer group_no
    integer port_no
    text status
  }
  station_equipment {
    uuid id PK
    uuid station_id FK
    text equipment_type
    text status
    uuid updated_by FK
  }
  equipment_inspections {
    uuid id PK
    uuid station_id FK
    text term
    text equipment_type
    text condition
    uuid inspector_id FK
    uuid last_borrower_id FK
  }
  repair_records {
    uuid id PK
    uuid station_id FK
    text status
    uuid reported_by FK
    uuid repaired_by FK
    timestamptz repaired_at
  }
  room_reports {
    uuid id PK
    text kind
    text room_id FK
    uuid station_id FK
    uuid lan_port_id FK
    text status
    uuid reported_by FK
    uuid handled_by FK
    uuid repair_id FK
  }
  room_status_log {
    bigint id PK
    text room_id
    uuid station_id FK
    uuid lan_port_id FK
    text from_status
    text to_status
    uuid changed_by FK
  }

